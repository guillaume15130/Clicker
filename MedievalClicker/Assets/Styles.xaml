<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MedievalClicker.Converters">

    <!-- Converters -->
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- Colors -->
    <Color x:Key="DarkBrown">#2C1810</Color>
    <Color x:Key="MediumBrown">#5C3A21</Color>
    <Color x:Key="LightBrown">#8B6914</Color>
    <Color x:Key="Parchment">#F5E6C8</Color>
    <Color x:Key="DarkParchment">#D4C4A0</Color>
    <Color x:Key="GoldColor">#FFD700</Color>
    <Color x:Key="DarkGold">#B8860B</Color>
    <Color x:Key="StoneGray">#4A4A4A</Color>

    <SolidColorBrush x:Key="DarkBrownBrush" Color="{StaticResource DarkBrown}" />
    <SolidColorBrush x:Key="MediumBrownBrush" Color="{StaticResource MediumBrown}" />
    <SolidColorBrush x:Key="LightBrownBrush" Color="{StaticResource LightBrown}" />
    <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource Parchment}" />
    <SolidColorBrush x:Key="DarkParchmentBrush" Color="{StaticResource DarkParchment}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="DarkGoldBrush" Color="{StaticResource DarkGold}" />
    <SolidColorBrush x:Key="StoneGrayBrush" Color="{StaticResource StoneGray}" />

    <!-- Medieval Button Style -->
    <Style x:Key="MedievalButton" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8B6914" Offset="0" />
                    <GradientStop Color="#5C3A21" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkGoldBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#A07B1A" Offset="0" />
                                        <GradientStop Color="#7A4E2D" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4A2D10" Offset="0" />
                                        <GradientStop Color="#3A1F0A" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Big Mine Button -->
    <Style x:Key="MineButton" TargetType="Button" BasedOn="{StaticResource MedievalButton}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Padding" Value="30,20" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="80" />
    </Style>

    <!-- Panel Style -->
    <Style x:Key="GamePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MediumBrownBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="5" />
    </Style>

    <!-- Header Text -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource DarkBrownBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Normal Text -->
    <Style x:Key="GameText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource DarkBrownBrush}" />
    </Style>

    <!-- Gold Display -->
    <Style x:Key="GoldText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource DarkGoldBrush}" />
    </Style>

    <!-- ProgressBar Style -->
    <Style x:Key="MedievalProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="{StaticResource DarkParchmentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LightBrownBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MediumBrownBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
